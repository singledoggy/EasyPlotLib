# Matplotlib style for EasyPlotlib

# Set color cycle: blue, green, yellow, red, violet, gray
axes.prop_cycle : cycler('color', ['0C5DA5', '00B945', 'FF9500', 'FF2C00', '845B97', '474747', '9e9e9e'])

# figure.figsize : 3.5, 2.625

# Set x axis
xtick.direction : out
xtick.major.size : 3
xtick.major.width : 0.5
xtick.minor.size : 1.5
xtick.minor.width : 0.5
# xtick.minor.visible : True
# xtick.top : True

# Set y axis
ytick.direction : out
ytick.major.size : 3
ytick.major.width : 0.5
ytick.minor.size : 1.5
ytick.minor.width : 0.5
# ytick.minor.visible : True
# ytick.right : True

# Set line widths
axes.linewidth : 0.5
grid.linewidth : 0.5
lines.linewidth : 1.
lines.markersize: 3


# Open frame: drop the top/right spines (Nature default)
axes.spines.top : False
axes.spines.right : False

# Remove legend frame
legend.frameon : False

# Always save as 'tight'
savefig.bbox : tight
savefig.pad_inches : 0.05

# Resolution: crisp on-screen preview, journal-grade rasters
figure.dpi : 200
savefig.dpi : 600

# Keep text editable in vector exports (Illustrator/Inkscape friendly)
pdf.fonttype : 42
ps.fonttype : 42
svg.fonttype : none

# Font sizes
axes.labelsize: 7
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
font.size: 7

# Custom font settings
font.sans-serif: TeX Gyre Heros
font.serif: TeX Gyre Schola
font.cursive: TeX Gyre Chorus
font.fantasy: TeX Gyre Adventor
font.monospace: TeX Gyre Cursor

font.family: sans-serif
mathtext.fontset : dejavuserif

axes.formatter.use_mathtext : True
